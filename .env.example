# Persistent SQLite database path
JKG_DB_PATH=./data/jkg.sqlite3

# Trained local multilingual embeddings; first run downloads the model.
JKG_EMBEDDING_PROVIDER=sentence-transformers
# JKG_MODEL_CACHE=./data/models
# JKG_OFFLINE=1  # enable after the model has been cached
# Use JKG_EMBEDDING_PROVIDER=hash only for explicit lexical-only operation.

# Optional remote providers; leave blank for local-only operation
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional runtime tuning
JKG_LLM_TIMEOUT_SECONDS=20
JKG_EMBEDDING_TIMEOUT_SECONDS=8
JKG_SQLITE_BUSY_TIMEOUT_MS=15000
